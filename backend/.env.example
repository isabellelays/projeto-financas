PORT=3001
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas: Clusters → Connect → Drivers → Node.js (troque usuário e senha)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/
MONGODB_DB=financas

# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Tentativas por IP a cada 15 minutos nas rotas de login/cadastro
RATE_LIMIT_AUTH=20
